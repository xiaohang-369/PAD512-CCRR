    def test_receiver_rejects_occupancy_hole():
        record = split_stream(bytes(16), 0, 1)[0]
        bits = torch.tensor(record.bits())
        row = torch.full((177,), -20.0)
        row[0] = 20
        row[1 + record.version] = 20
        row[5 + record.alpha] = 20
        row[7 + record.level] = 20
