      "training_config": "phase2-g1.json",
      "medical_acceptance_threshold": null,
      "development_epochs": 30
    },
    {
      "id": "p3_supervised_embedding",
      "requires": "p2_supervised",
      "payload": "encrypt_Zc_and_independent_records",
      "objective": "adaptive_embedding_under_existing_supervision",
      "compare": [
        "Gpub",
        "G1",
        "G0",
        "ordinary_gray"
      ],
      "criterion": "retain_identity_medical_tradeoff_after_embedding",
      "state": "not_started"
