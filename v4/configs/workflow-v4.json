    "Zc": "int16(Q8(G0))-int16(Q8(G1))",
    "Gpub": "actual_embedded_published_gray",
    "D0": "preserved_original_decoder",
    "W": "adaptive_communication_encoder",
    "R": "adaptive_communication_decoder"
  },
  "stages": [
    {
      "id": "p1_original",
      "source_config": "phase1-train.json",
      "objective": "original_joint_ED_training_with_original_losses_stages_and_8bit_validation",
