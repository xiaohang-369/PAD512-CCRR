{
  "schema": "ccrr-v4-workflow-design-1",
  "status": "design_not_training_cli",
  "next_stage": "p2_supervised",
  "protocol_fixture_counts_as_stage_completion": false,
  "notation": {
    "G0": "original_method_encoded_gray",
