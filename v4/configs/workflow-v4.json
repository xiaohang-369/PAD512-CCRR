      "output": [
        "baseline_checkpoint",
        "G0",
        "original_recovery_evaluation"
      ],
      "state": "training_completed_reviewed_previews",
      "implementation": "phase1_completed_120_epochs_10800_updates",
      "baseline_checkpoint_sha256": "5d7f8c2bed98356166bbecebbc87a7fb4324e75126a347e6173788a7fcbef387"
    },
    {
      "id": "p2_supervised",
      "requires": "p1_original",
      "init": "copy_p1_checkpoint_preserve_original_version",
      "teacher_frozen": true,
      "teacher_input_gradients": true,
      "objective": "add_existing_supervision_to_original_task",
      "compare": [
        "G1",
        "G0",
        "ordinary_gray"
      ],
      "criterion": "lower_identity_recognition_and_acceptable_medical_loss",
      "loss_weights": {
        "original": "author_stage2",
        "medical": 0.1,
        "medical_kd": 0.5,
        "identity": 0.1
      },
      "state": "baseline_evaluated_g1_implementation_ready_server_pending",
      "resource_config": "phase2-resources.json",
